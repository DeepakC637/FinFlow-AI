# FinFlow Backend Environment Configuration

# Server Port (default: 5000)
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# JWT Authentication Secret Key (minimum 32 random characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Allowed Frontend Client Origin for CORS (e.g., http://localhost:5173 in development)
CLIENT_URL=http://localhost:5173

# Groq Cloud API Key for AI OCR Receipt Parsing (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Vision Model Identifier (optional, default: qwen/qwen3.8-27b)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
